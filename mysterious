-- วนกดจนปุ่มเล่นหายไป (= เข้าด่านได้แล้ว) เผื่อด่านมีคูลดาวน์
local function step5_confirm()
    -- รอให้ปุ่มโผล่ก่อน (สูงสุด 10 วิ)
    local waited = 0
    while alive() and settings.autoChallenge and waited < 10 do
        local b = getPlayBtn()
        if b and isShown(b) then break end
        task.wait(0.5)
        waited += 0.5
    end

    local b = getPlayBtn()
    if not (b and isShown(b)) then
        warn("[Challenge] ขั้น 5: ไม่เจอปุ่มเล่น")
        return
    end

    local start = os.clock()
    local attempt = 0
    while alive() and settings.autoChallenge do
        local btn = getPlayBtn()
        if not btn or not isShown(btn) then
            setChStatus("เข้าด่านแล้ว (กดครั้งที่ " .. attempt .. ")")
            return
        end
        if findLeaveBtn() then return end -- ขึ้นหน้าจบด่านแล้ว
        if os.clock() - start > CONFIRM_MAX then
            setChStatus("กดเล่นนานเกินกำหนด รอรอบถัดไป")
            return
        end

        attempt += 1
        setChStatus(("ขั้น 5: กดเล่นซ้ำ ครั้งที่ %d"):format(attempt))
        pcall(step5_pressOnce)
        task.wait(CONFIRM_INTERVAL)
    end
end

-- ==================================================
-- ตัวรันรอบ (คุมด้วยปุ่มเปิด/ปิด Auto Challenge)
-- ==================================================
local steps = {
    { "วาร์ป", step1_warp },
    { "สร้างล็อบบี้", step2_create },
    { "เลือกโหมด + กดเล่นของโหมด", step34_mode },
    { "กดยืนยันเล่น (วนจนเข้า)", step5_confirm },
}

local function runRound()
    for i, s in ipairs(steps) do
        if not alive() or not settings.autoChallenge then return end
        setChStatus(("ขั้น %d/%d: %s"):format(i, #steps, s[1]))
        local ok, err = pcall(s[2])
        if not ok then
            warn(("[Challenge] ขั้น %d (%s) พลาด: %s"):format(i, s[1], tostring(err)))
        end
        task.wait(STEP_DELAY)
    end
end

task.spawn(function()
    task.wait(AUTO_HIDE_DELAY + 1) -- รอ UI ซ่อนก่อน กันคลิกโดน UI
    local t0 = nil
    while alive() do
        if not settings.autoChallenge then
            t0 = nil
            setChchallengeOff = nil
            setChStatus("ปิดอยู่")
            task.wait(0.5)
        else
            local now = os.clock()
            if not t0 or now - t0 >= COOLDOWN_MIN * 60 then
                t0 = now
                runRound()
            else
                local remain = COOLDOWN_MIN * 60 - (now - t0)
                setChStatus(("รอรอบถัดไป %02d:%02d"):format(math.floor(remain / 60), math.floor(remain % 60)))
                task.wait(1)
            end
        end
    end
end)

-- ==================================================
-- ขั้นที่ 6: Auto Leave (คลิกเมาส์กลางปุ่ม)
-- ==================================================
local leaving = false

task.spawn(function()
    while alive() do
        task.wait(0.5)
        if settings.autoLeave and not leaving then
            local btn = findLeaveBtn()
            if btn then
                leaving = true
                setLeaveStatus("เจอปุ่มออกแล้ว กำลังกด...")
                task.wait(0.5) -- รอแอนิเมชันปุ่มเข้าที่

                -- คลิกซ้ำสูงสุด 5 ครั้ง จนปุ่มหาย (หาตำแหน่งใหม่ทุกครั้ง)
                for i = 1, 5 do
                    btn = findLeaveBtn()
                    if not btn then break end
                    pcall(clickCenter, btn)
                    task.wait(1.5)
                end

                setLeaveStatus("ออกแล้ว รอหน้าจบด่านรอบถัดไป...")
                leaving = false
                task.wait(3)
            end
        end
    end
end)


-- ==================================================
-- ขั้นที่ 3-4: เลือกโหมด + กดเล่นของโหมด (โค้ดของคุณ)
-- ==================================================
local function step34_mode()
    local vim = game:GetService("VirtualInputManager")
    local gs = game:GetService("GuiService")
    local rs = game:GetService("RunService")
    local pg = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

    -- ฟังก์ชันของขั้นที่ 2 (แบบเก่า)
    local function selectGui(btn)
        btn.Selectable = true
        gs.SelectedObject = btn
    end

    local function mouseClick(btn)
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local inset = gs:GetGuiInset()
        local x = pos.X + size.X / 2
        local y = pos.Y + size.Y / 2 + inset.Y

        vim:SendMouseMoveEvent(x, y, game)
        task.wait(0.05)
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end

    local function enterClick()
        vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
        task.wait(0.1)
        vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    end

    -- ฟังก์ชันของขั้นที่ 3 (แบบใหม่)
    local function findButton(root)
        for _, name in ipairs({"Inner", "Outner", "Outer"}) do
            local c = root:FindFirstChild(name)
            if c and c:IsA("GuiButton") then return c end
        end
        if root:IsA("GuiButton") then return root end
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("GuiButton") then return d end
        end
    end

    -- keep = true: กดเสร็จแล้วเลือกค้างไว้ / false: กดเสร็จแล้วเคลียร์
    local function clickGui(btn, keep)
        gs.SelectedObject = btn
        task.wait(0.1)
        vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
        task.wait(0.1)
        vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
        task.wait()
        if not keep then gs.SelectedObject = nil end
    end

    -- ขั้นที่ 2: เลือกโหมด Regular (แบบเก่า)
    local regular = pg:WaitForChild("Challengs").Main.Mode:WaitForChild("Regular")
    local inner = regular:WaitForChild("Inner")

    selectGui(inner)
    task.wait(0.1)
    enterClick()
    mouseClick(inner)

    -- กันเกมแย่งเลือก (เก็บไว้ เพื่อ disconnect ก่อนขั้น 3)
    local conn = rs.Heartbeat:Connect(function()
        if gs.SelectedObject ~= inner then
            gs.SelectedObject = inner
        end
    end)

    task.wait(1.5) -- รอให้การ์ดโผล่

    -- ขั้นที่ 3: กดเล่นของโหมด (แบบใหม่)
    conn:Disconnect() -- เลิกล็อกที่ Regular.Inner

    local selectBtn = pg.Challengs.Main.Container.RegularCard:WaitForChild("SelectBtn")
    selectBtn:WaitForChild("Inner", 5)
    local target = findButton(selectBtn)
    print("ขั้น 3 เลือก:", target and target:GetFullName(), target and target.ClassName)

    if target then
        clickGui(target, true) -- true = เลือกค้างไว้ / false = กดเสร็จแล้วปล่อย
        print("เลือกค้างที่:", gs.SelectedObject == target)
    end
end


-- ปุ่มต้องมองเห็นจริงทุกชั้น
local function isShown(obj)
    local p = obj
    while p and p ~= pg do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("LayerCollector") and not p.Enabled then return false end
        p = p.Parent
    end
    return p == pg
end

local function findLeaveBtn()
    local eg = pg:FindFirstChild("EndGame")
    local frame = eg and eg:FindFirstChild("EndGameFrame")
    local buttons = frame and frame:FindFirstChild("Buttons")
    local leave = buttons and buttons:FindFirstChild("LeaveBtn")
    if not leave then return nil end

    for _, n in ipairs({"Inner", "Outner"}) do
        local c = leave:FindFirstChild(n)
        if c and c:IsA("GuiButton") and isShown(c) and c.AbsoluteSize.X > 0 then return c end
    end
    for _, n in ipairs({"Inner", "Outner"}) do
        local c = leave:FindFirstChild(n)
        if c and c:IsA("GuiObject") and isShown(c) and c.AbsoluteSize.X > 0 then return c end
    end
    return nil
end

local function getPlayBtn()
    local g = pg:FindFirstChild("PlayGUI")
    local f = g and g:FindFirstChild("PlayFrame")
    local c = f and f:FindFirstChild("ContainerBtn")
    return c and c:FindFirstChild("PlayBtn")
end

-- จุดกึ่งกลางปุ่มบนหน้าจอ (บวก GuiInset เฉพาะเมื่อ ScreenGui ไม่ได้ IgnoreGuiInset)
local function getCenter(btn)
    local pos = btn.AbsolutePosition
    local size = btn.AbsoluteSize
    local x = pos.X + size.X / 2
    local y = pos.Y + size.Y / 2

    local sg = btn:FindFirstAncestorWhichIsA("ScreenGui")
    if not sg or not sg.IgnoreGuiInset then
        y = y + gs:GetGuiInset().Y
    end
    return x, y
end

local function clickCenter(btn)
    local x, y = getCenter(btn)

    vim:SendMouseMoveEvent(x, y, game)
    task.wait(0.1)
    vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.1)
    vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
end


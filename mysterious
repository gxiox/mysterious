-- ==================================================
-- ตัวรันรอบ
-- ==================================================
local autoOn = false
local looping = false
local busy = false
local cooldownMin = 30
local stepDelay = 2

local Status = Tabs.Main:AddParagraph({ Title = "สถานะ", Content = "ยังไม่เริ่ม" })
local function setStatus(text)
    pcall(function() Status:SetDesc(text) end)
end

local steps = {
    { "วาร์ป", step1_warp },
    { "สร้างล็อบบี้", step2_create },
    { "เลือกโหมด + กดเล่นของโหมด", step34_mode },
    { "กดยืนยันเล่น", step5_confirm },
}

-- force = true: รันให้ครบ แม้ปิด Auto (ใช้กับปุ่มรันทันที)
local function runRound(force)
    for i, s in ipairs(steps) do
        if not force and not autoOn then return false end
        setStatus(("ขั้น %d/%d: %s"):format(i, #steps, s[1]))
        local ok, err = pcall(s[2])
        if not ok then
            warn(("[Challenge] ขั้น %d (%s) พลาด: %s"):format(i, s[1], tostring(err)))
            Fluent:Notify({ Title = "ขั้น " .. i .. " พลาด", Content = s[1], Duration = 4 })
        end
        task.wait(stepDelay)
    end
    return true
end

local function loop()
    if looping then return end
    looping = true
    while autoOn do
        local t0 = os.clock()
        busy = true
        runRound(false)
        busy = false

        while autoOn do
            local remain = cooldownMin * 60 - (os.clock() - t0)
            if remain <= 0 then break end
            setStatus(("รอรอบถัดไป %02d:%02d"):format(math.floor(remain / 60), math.floor(remain % 60)))
            task.wait(1)
        end
    end
    looping = false
    setStatus("หยุดแล้ว")
end

local AutoToggle = Tabs.Main:AddToggle("AutoChallenge", {
    Title = "เปิด Auto Challenge",
    Default = false
})

AutoToggle:OnChanged(function(state)
    autoOn = state
    if state then task.spawn(loop) end
    Fluent:Notify({ Title = "Challenge", Content = state and "เริ่มทำงาน" or "หยุดทำงาน", Duration = 3 })
end)

Tabs.Main:AddSlider("CooldownMin", {
    Title = "เวลารอระหว่างรอบ (นาที)",
    Min = 1,
    Max = 60,
    Default = 30,
    Increment = 1,
    Rounding = 0,
    Callback = function(v) cooldownMin = v end
})

Tabs.Main:AddSlider("StepDelay", {
    Title = "หน่วงระหว่างขั้น (วินาที)",
    Min = 1,
    Max = 10,
    Default = 2,
    Increment = 0.5,
    Rounding = 1,
    Callback = function(v) stepDelay = v end
})

Tabs.Main:AddButton({
    Title = "รันทันที 1 รอบ",
    Callback = function()
        if busy then
            Fluent:Notify({ Title = "Challenge", Content = "กำลังรันอยู่", Duration = 3 })
            return
        end
        task.spawn(function()
            busy = true
            runRound(true)
            busy = false
            setStatus("รันครบ 1 รอบแล้ว")
        end)
    end
})

